### Create Restaurant
POST http://localhost:8080/api/restaurants
Content-Type: application/json

{
  "name": "Pizza Paradise",
  "cuisine": "ITALIAN",
  "address": "123 Main Street, 1000, 1000, Brussels, Belgium",
  "contactEmail": "info@pizzaparadise.be",
  "imageUrls": [
    "https://example.com/pizza1.jpg",
    "https://example.com/pizza2.jpg"
  ],
  "defaultPrepTimeMinutes": 30,
  "openingHours": "Mon-Fri: 11:00-22:00, Sat-Sun: 12:00-23:00"
}

### Get All Restaurants
GET http://localhost:8080/api/restaurants

### Get Restaurant by ID (replace with actual UUID from create response)
GET http://localhost:8080/api/restaurants/{{restaurantId}}

### Create Second Restaurant (same owner - should fail)
POST http://localhost:8080/api/restaurants
Content-Type: application/json

{
  "name": "La Bella Italia",
  "cuisine": "ITALIAN",
  "address": "Rue de la Loi, 123, 1000, Brussels, Belgium",
  "contactEmail": "info@labellaitalia.be",
  "imageUrls": [
    "https://example.com/restaurant1.jpg",
    "https://example.com/restaurant2.jpg"
  ],
  "defaultPrepTimeMinutes": 30,
  "openingHours": "Mon-Sun: 10:00-22:00"
}

###############################################
# DISH MANAGEMENT
###############################################

### Create Dish (Draft) - replace {{restaurantId}} with your actual restaurant UUID
POST http://localhost:8080/api/restaurants/e68dc595-78a2-461e-a13f-1e5412d0734a/dishes
Content-Type: application/json


{
  "name": "Margherita Pizza",
  "type": "MAIN",
  "foodTags": ["LACTOSE", "GLUTEN"],
  "description": "Classic Italian pizza with tomato sauce and mozzarella",
  "price": 12.50,
  "imageUrl": "https://example.com/margherita.jpg"
}

### Create Another Dish
POST http://localhost:8080/api/restaurants/b44c6db4-528e-473f-a006-7908ebbc158b/dishes
Content-Type: application/json

{
  "name": "Tiramisu",
  "type": "DESSERT",
  "foodTags": ["LACTOSE", "GLUTEN"],
  "description": "Traditional Italian dessert with coffee and mascarpone",
  "price": 7.50,
  "imageUrl": "https://example.com/tiramisu.jpg"
}

### Get All Dishes for Restaurant
GET http://localhost:8080/api/restaurants/b44c6db4-528e-473f-a006-7908ebbc158b/dishes

### Get Single Dish
GET http://localhost:8080/api/restaurants/b44c6db4-528e-473f-a006-7908ebbc158b/dishes/01145af5-8612-4dbd-bbc0-cc4efe87b8f3

### Update Dish (marks as having pending changes)
PUT http://localhost:8080/api/restaurants/b44c6db4-528e-473f-a006-7908ebbc158b/dishes/01145af5-8612-4dbd-bbc0-cc4efe87b8f3
Content-Type: application/json

{
  "name": "Margherita Pizza Deluxe",
  "type": "MAIN",
  "foodTags": ["LACTOSE", "GLUTEN"],
  "description": "Classic Italian pizza with tomato sauce, mozzarella and fresh basil",
  "price": 13.50,
  "imageUrl": "https://example.com/margherita-deluxe.jpg"
}

### Publish Dish (makes it visible to customers)
POST http://localhost:8080/api/restaurants/b44c6db4-528e-473f-a006-7908ebbc158b/dishes/{{dishId}}/publish

### Mark Dish Out of Stock (immediate)
POST http://localhost:8080/api/restaurants/b44c6db4-528e-473f-a006-7908ebbc158b/dishes/{{dishId}}/out-of-stock

### Mark Dish Back In Stock (immediate)
POST http://localhost:8080/api/restaurants/b44c6db4-528e-473f-a006-7908ebbc158b/dishes/{{dishId}}/in-stock

### Unpublish Dish (removes from menu)
POST http://localhost:8080/api/restaurants/b44c6db4-528e-473f-a006-7908ebbc158b/dishes/{{dishId}}/unpublish

### Get Count of Pending Changes
GET http://localhost:8080/api/restaurants/b44c6db4-528e-473f-a006-7908ebbc158b/dishes/pending-changes/count

